# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
IMAGE_TAG=local

POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me-locally

# Static bearer token for the APIs (empty = auth disabled, local demo only)
API_TOKEN=

# Upload limits
MAX_UPLOAD_MB=50

# Module 2 — optional semantic search (also start: docker compose --profile semantic up)
ENABLE_SEMANTIC=false

# Module 3 — batch processing
RULES_CHUNK_SIZE=5000
RULES_WORKER_CONCURRENCY=4
