{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reg IRIS rule file",
  "description": "One regulator's validation rules. Backward compatible with the hackathon sample files; optional fields add severity, applicability and clause traceability.",
  "type": "object",
  "required": ["regulator", "rules"],
  "properties": {
    "regulator": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string"},
    "version": {"type": "string"},
    "source_document": {
      "type": "object",
      "properties": {"document_id": {"type": "string"}, "document_key": {"type": "string"}, "version_label": {"type": "string"}}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "logic"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-]{1,64}$"},
          "description": {"type": "string", "minLength": 1},
          "logic": {},
          "impact": {"type": "string"},
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "applies_when": {},
          "enabled": {"type": "boolean"},
          "source": {
            "type": "object",
            "properties": {"clause_ref": {"type": "string"}, "document_id": {"type": "string"}, "page": {"type": "integer"}}
          }
        }
      }
    }
  }
}
